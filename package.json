{
	"$schema": "https://www.schemastore.org/package",
	"private": true,
	"type": "module",
	"scripts": {
		"fmt": "oxfmt --no-error-on-unmatched-pattern",
		"fmt:check": "oxfmt --no-error-on-unmatched-pattern --check"
	},
	"devDependencies": {
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.14",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.22",
			"onFail": "download"
		}
	}
}
