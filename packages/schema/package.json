{
	"$schema": "https://www.schemastore.org/package",
	"name": "@sytizen/schema",
	"version": "0.0.0",
	"description": "Standard Schema data declaration and validation",
	"keywords": [
		"data",
		"declaration",
		"schema",
		"standard",
		"typescript",
		"validation"
	],
	"homepage": "https://github.com/sytizen/sytizen/tree/master/packages/schema#readme",
	"bugs": {
		"url": "https://github.com/sytizen/sytizen/issues"
	},
	"license": "MIT",
	"author": "Hunar Roop Kahlon <hunarroopcodes@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sytizen/sytizen.git",
		"directory": "packages/schema"
	},
	"files": [
		"./LICENSE",
		"./README.md",
		"./package.json"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./LICENSE": "./LICENSE",
		"./package.json": "./package.json"
	},
	"scripts": {
		"fmt:check": "oxfmt --no-error-on-unmatched-pattern --check"
	},
	"devDependencies": {
		"oxfmt": "catalog:"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.21",
			"onFail": "download"
		}
	}
}
