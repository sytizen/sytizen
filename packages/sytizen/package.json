{
	"$schema": "https://www.schemastore.org/package",
	"name": "@sytizen/sytizen",
	"version": "0.0.0",
	"description": "Fast modern web framework",
	"keywords": [
		"fast",
		"framework",
		"modern",
		"web"
	],
	"homepage": "https://github.com/sytizen/sytizen/tree/master/packages/sytizen#readme",
	"bugs": {
		"url": "https://github.com/sytizen/sytizen/issues"
	},
	"license": "MIT",
	"author": "Hunar Roop Kahlon <hunarroopcodes@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sytizen/sytizen.git",
		"directory": "packages/sytizen"
	},
	"files": [
		"./LICENSE",
		"./README.md",
		"./package.json"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./LICENSE": "./LICENSE",
		"./package.json": "./package.json"
	},
	"scripts": {
		"emit": "tsc --build",
		"fmt": "oxfmt --no-error-on-unmatched-pattern",
		"fmt:check": "oxfmt --no-error-on-unmatched-pattern --check",
		"lint": "oxlint --no-error-on-unmatched-pattern",
		"lint:fix": "oxlint --no-error-on-unmatched-pattern --fix",
		"types:check": "tsc --build --noEmit"
	},
	"devDependencies": {
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:"
	},
	"peerDependencies": {
		"typescript": "catalog:"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.22",
			"onFail": "download"
		}
	}
}
