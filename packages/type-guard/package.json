{
	"$schema": "https://www.schemastore.org/package",
	"name": "@sytizen/type-guard",
	"version": "0.0.0",
	"description": "Runtime type guards so Sytizen (and consumers) can share safe, reusable narrowing helpers",
	"keywords": [
		"guard",
		"sytizen",
		"type"
	],
	"homepage": "https://github.com/sytizen/sytizen/tree/master/packages/type-guard#readme",
	"bugs": {
		"url": "https://github.com/sytizen/sytizen/issues"
	},
	"license": "MIT",
	"author": "Hunar Roop Kahlon <hunarroopcodes@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sytizen/sytizen.git",
		"directory": "packages/type-guard"
	},
	"files": [
		"./LICENSE",
		"./README.md",
		"./package.json"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./LICENSE": "./LICENSE",
		"./package.json": "./package.json"
	},
	"scripts": {
		"fmt": "oxfmt --no-error-on-unmatched-pattern",
		"fmt:check": "oxfmt --no-error-on-unmatched-pattern --check",
		"lint": "oxlint --no-error-on-unmatched-pattern"
	},
	"devDependencies": {
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.21",
			"onFail": "download"
		}
	}
}
